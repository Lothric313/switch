# Server only. Do NOT prefix secrets with VITE_.
PORT=5173
APP_ORIGIN=http://localhost:5173
TRUST_PROXY=0

# resend (default) or smtp (Node hosting only)
MAIL_PROVIDER=resend
CONTACT_TO=studio@example.com
MAIL_FROM=SWITCH <hello@your-verified-domain.com>
RESEND_API_KEY=

# Used only with MAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
